<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio Pulse // Split-Flap Display</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        :root {
            --bg-color: #050505;
            --accent-color: #00ffaa;
            --flap-bg: #111;
            --flap-text: #eee;
            --panel-border: 1px solid rgba(0, 255, 170, 0.2);
            --clack-speed: 0.1s;
        }

        body, html {
            margin: 0;
            padding: 0;
            background: var(--bg-color);
            color: white;
            font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
            height: 100%;
            overflow: hidden;
        }

        /* PORTABLE CONTAINER */
        .pulse-widget {
            display: flex;
            width: 100%;
            height: 100%;
            min-height: 300px;
            background: #000;
            border: var(--panel-border);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        @media (max-width: 768px) {
            .pulse-widget { flex-direction: column; }
        }

        /* MEDIA SECTION */
        .media-window {
            flex: 1;
            position: relative;
            background: #080808;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-right: var(--panel-border);
        }

        .media-window img, .media-window video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(0.2) contrast(1.1);
            transition: transform 0.5s ease;
        }

        .media-overlay {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0,0,0,0.7);
            padding: 5px 10px;
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--accent-color);
            border: 1px solid var(--accent-color);
            text-transform: uppercase;
        }

        /* SPLIT-FLAP SECTION */
        .flap-board {
            flex: 1.2;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: linear-gradient(135deg, #0a0a0a 0%, #000 100%);
        }

        .board-header {
            font-size: 10px;
            letter-spacing: 4px;
            color: rgba(255,255,255,0.3);
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .flap-row {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        /* INDIVIDUAL FLAP CELL */
        .flap {
            position: relative;
            width: 34px;
            height: 50px;
            background: var(--flap-bg);
            border-radius: 4px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 32px;
            font-weight: bold;
            line-height: 50px;
            text-align: center;
            perspective: 200px;
        }

        .flap .top, .flap .bottom {
            position: absolute;
            left: 0;
            width: 100%;
            height: 50%;
            overflow: hidden;
            background: var(--flap-bg);
            color: var(--flap-text);
        }

        .flap .top {
            top: 0;
            border-bottom: 1px solid #000;
            border-radius: 4px 4px 0 0;
            line-height: 50px;
        }

        .flap .bottom {
            bottom: 0;
            border-radius: 0 0 4px 4px;
            line-height: 0;
        }

        /* FLIP ANIMATION */
        .flipping .top {
            animation: flip-top var(--clack-speed) forwards;
            transform-origin: bottom;
        }

        @keyframes flip-top {
            0% { transform: rotateX(0deg); }
            100% { transform: rotateX(-90deg); }
        }

        .pulse-glow {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 8px;
            height: 8px;
            background: var(--accent-color);
            border-radius: 50%;
            box-shadow: 0 0 15px var(--accent-color);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(0.8); }
            100% { opacity: 1; transform: scale(1); }
        }

    </style>
</head>
<body>

    <div class="pulse-widget">
        <!-- Media Section -->
        <div class="media-window" id="mediaContainer">
            <div class="media-overlay">Live Studio Pulse</div>
            <img id="mainMedia" src="https://via.placeholder.com/1080x1920?text=Waiting+for+Pulse..." alt="Studio Media">
        </div>

        <!-- Split-Flap Section -->
        <div class="flap-board">
            <div class="board-header">Latest Studio Event // Arrival</div>
            <div class="flap-row" id="flapRow">
                <!-- Flaps generated by JS -->
            </div>
            <div class="pulse-glow"></div>
        </div>
    </div>

    <script>
        // --- CONFIGURATION ---
        const SUPABASE_URL = "YOUR_SUPABASE_URL";
        const SUPABASE_KEY = "YOUR_SUPABASE_KEY";
        const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        const flapRow = document.getElementById('flapRow');
        const mediaContainer = document.getElementById('mediaContainer');
        const mainMedia = document.getElementById('mainMedia');
        
        const CHARS = " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789◈:#-.".split("");
        const ROW_SIZE = 18; // Max characters per row

        // Init Board
        let currentText = "SYSTEM STANDBY".padEnd(ROW_SIZE, " ");
        createFlaps(currentText);

        function createFlaps(text) {
            flapRow.innerHTML = "";
            for (let i = 0; i < ROW_SIZE; i++) {
                const flap = document.createElement('div');
                flap.className = 'flap';
                flap.innerHTML = `
                    <div class="top">${text[i]}</div>
                    <div class="bottom">${text[i]}</div>
                `;
                flapRow.appendChild(flap);
            }
        }

        async function updateBoard(newText, mediaUrl) {
            newText = newText.toUpperCase().padEnd(ROW_SIZE, " ").substring(0, ROW_SIZE);
            const flaps = document.querySelectorAll('.flap');

            // Update Media
            if (mediaUrl) {
                mainMedia.style.opacity = 0;
                setTimeout(() => {
                    mainMedia.src = mediaUrl;
                    mainMedia.style.opacity = 1;
                }, 500);
            }

            // Mechanical Flip Sequence
            for (let i = 0; i < ROW_SIZE; i++) {
                if (newText[i] !== currentText[i]) {
                    animateFlap(flaps[i], currentText[i], newText[i]);
                }
            }
            currentText = newText;
        }

        function animateFlap(element, startChar, endChar) {
            let currentIndex = CHARS.indexOf(startChar);
            const targetIndex = CHARS.indexOf(endChar);
            
            const interval = setInterval(() => {
                element.classList.add('flipping');
                
                currentIndex = (currentIndex + 1) % CHARS.length;
                const char = CHARS[currentIndex];
                
                element.querySelector('.top').innerText = char;
                element.querySelector('.bottom').innerText = char;
                
                // Play Clack Sound (Optional)
                // playClack();

                if (currentIndex === targetIndex) {
                    clearInterval(interval);
                    element.classList.remove('flipping');
                }
            }, 70); // Speed of the mechanical spin
        }

        // --- REALTIME LISTENER ---
        const channel = supabase
            .channel('public:feed')
            .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'feed' }, (payload) => {
                console.log('New Pulse Received!', payload.new);
                const data = payload.new;
                updateBoard(data.action_label || "NEW ACTIVITY", data.asset_url);
            })
            .subscribe();

        // Initial Fetch
        async function fetchLatest() {
            const { data, error } = await supabase
                .from('feed')
                .select('*')
                .order('timestamp', { ascending: false })
                .limit(1);
            
            if (data && data.length > 0) {
                updateBoard(data[0].action_label, data[0].asset_url);
            }
        }
        
        fetchLatest();

    </script>
</body>
</html>
